#!/usr/bin/env bash
set -euo pipefail

GADGET_NAME="${GADGET_NAME:-kvm}"
UDC_NAME="${UDC_NAME:-fc000000.usb}"
GADGET_ROOT="/sys/kernel/config/usb_gadget"
GADGET_DIR="${GADGET_ROOT}/${GADGET_NAME}"
MODE_FILE="/sys/kernel/debug/usb/${UDC_NAME}/mode"

log() {
    printf 'kvm-gadget: %s\n' "$*"
}

require_root() {
    if [[ "${EUID}" -ne 0 ]]; then
        log "must run as root"
        exit 1
    fi
}

check_platform() {
    [[ -e "${MODE_FILE}" ]] || {
        log "USB mode control not found: ${MODE_FILE}"
        exit 1
    }
    [[ -e "/sys/class/udc/${UDC_NAME}" ]] || {
        log "UDC not found: ${UDC_NAME}"
        exit 1
    }
}

ensure_configfs() {
    modprobe libcomposite
    if ! mountpoint -q /sys/kernel/config; then
        mount -t configfs configfs /sys/kernel/config
    fi
}

write_keyboard_descriptor() {
    printf '\x05\x01\x09\x06\xa1\x01\x05\x07\x19\xe0\x29\xe7\x15\x00\x25\x01\x75\x01\x95\x08\x81\x02\x95\x01\x75\x08\x81\x01\x95\x05\x75\x01\x05\x08\x19\x01\x29\x05\x91\x02\x95\x01\x75\x03\x91\x01\x95\x06\x75\x08\x15\x00\x25\x65\x05\x07\x19\x00\x29\x65\x81\x00\xc0' > functions/hid.keyboard/report_desc
}

write_mouse_descriptor() {
    printf '\x05\x01\x09\x02\xa1\x01\x09\x01\xa1\x00\x05\x09\x19\x01\x29\x03\x15\x00\x25\x01\x95\x03\x75\x01\x81\x02\x95\x01\x75\x05\x81\x01\x05\x01\x09\x30\x09\x31\x09\x38\x15\x81\x25\x7f\x75\x08\x95\x03\x81\x06\xc0\xc0' > functions/hid.mouse/report_desc
}

create_gadget() {
    mkdir -p "${GADGET_DIR}"
    cd "${GADGET_DIR}"

    printf '0x1d6b' > idVendor
    printf '0x0104' > idProduct
    printf '0x0100' > bcdDevice
    printf '0x0200' > bcdUSB

    mkdir -p strings/0x409
    printf 'OPI5-KVM-001' > strings/0x409/serialnumber
    printf 'Orange Pi' > strings/0x409/manufacturer
    printf 'Remote KVM' > strings/0x409/product

    mkdir -p configs/c.1/strings/0x409
    printf 'Keyboard + Mouse' > configs/c.1/strings/0x409/configuration
    printf '250' > configs/c.1/MaxPower

    mkdir -p functions/hid.keyboard
    printf '1' > functions/hid.keyboard/protocol
    printf '1' > functions/hid.keyboard/subclass
    printf '8' > functions/hid.keyboard/report_length
    write_keyboard_descriptor

    mkdir -p functions/hid.mouse
    printf '2' > functions/hid.mouse/protocol
    printf '1' > functions/hid.mouse/subclass
    printf '4' > functions/hid.mouse/report_length
    write_mouse_descriptor

    ln -s ../../functions/hid.keyboard configs/c.1/hid.keyboard
    ln -s ../../functions/hid.mouse configs/c.1/hid.mouse
}

start_gadget() {
    require_root
    check_platform
    printf 'device' > "${MODE_FILE}"
    ensure_configfs

    if [[ ! -d "${GADGET_DIR}" ]]; then
        create_gadget
    fi

    if [[ ! -e "${GADGET_DIR}/configs/c.1/hid.keyboard" || ! -e "${GADGET_DIR}/configs/c.1/hid.mouse" ]]; then
        log "existing gadget is incomplete; refusing to overwrite it"
        exit 1
    fi

    local bound_udc
    bound_udc="$(<"${GADGET_DIR}/UDC")"
    if [[ -z "${bound_udc}" ]]; then
        printf '%s' "${UDC_NAME}" > "${GADGET_DIR}/UDC"
    elif [[ "${bound_udc}" != "${UDC_NAME}" ]]; then
        log "gadget is already bound to unexpected UDC: ${bound_udc}"
        exit 1
    fi

    log "started on ${UDC_NAME}"
}

stop_gadget() {
    require_root
    [[ -d "${GADGET_DIR}" ]] || return 0
    cd "${GADGET_DIR}"

    printf '' > UDC || true
    rm -f configs/c.1/hid.keyboard configs/c.1/hid.mouse
    rmdir functions/hid.keyboard functions/hid.mouse
    rmdir configs/c.1/strings/0x409 configs/c.1
    rmdir strings/0x409
    cd "${GADGET_ROOT}"
    rmdir "${GADGET_NAME}"
    log "stopped"
}

status_gadget() {
    check_platform
    printf 'mode=%s\n' "$(<"${MODE_FILE}")"
    if [[ -d "${GADGET_DIR}" ]]; then
        printf 'gadget=present\n'
        printf 'udc=%s\n' "$(<"${GADGET_DIR}/UDC")"
        [[ -e /dev/hidg0 ]] && printf 'keyboard=/dev/hidg0\n'
        [[ -e /dev/hidg1 ]] && printf 'mouse=/dev/hidg1\n'
    else
        printf 'gadget=absent\n'
    fi
}

case "${1:-}" in
    start) start_gadget ;;
    stop) stop_gadget ;;
    restart)
        stop_gadget
        start_gadget
        ;;
    status) status_gadget ;;
    *)
        echo "Usage: $0 {start|stop|restart|status}" >&2
        exit 2
        ;;
esac
